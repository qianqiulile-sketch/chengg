name: Android 打包

on:
  workflow_dispatch:
  push:
    branches: [ main, master ]

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 60

    steps:
      - name: 检出代码
        uses: actions/checkout@v4

      - name: 安装 JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: 安装 Android SDK 36
        run: |
          export ANDROID_SDK_ROOT=$HOME/android-sdk
          mkdir -p $ANDROID_SDK_ROOT/cmdline-tools
          curl -s https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -o cmdtools.zip
          unzip -q cmdtools.zip -d $ANDROID_SDK_ROOT/cmdline-tools
          mv $ANDROID_SDK_ROOT/cmdline-tools/cmdline-tools $ANDROID_SDK_ROOT/cmdline-tools/latest
          export PATH=$ANDROID_SDK_ROOT/cmdline-tools/latest/bin:$PATH
          yes | sdkmanager --licenses
          sdkmanager "platforms;android-36" "build-tools;36.0.0" "platform-tools"
          echo "ANDROID_SDK_ROOT=$ANDROID_SDK_ROOT" >> $GITHUB_ENV
          echo "ANDROID_HOME=$ANDROID_SDK_ROOT" >> $GITHUB_ENV

      - name: 赋予 gradlew 权限
        run: chmod +x gradlew

      - name: 打包 Debug APK
        run: ./gradlew --no-daemon assembleDebug -Pdia.localImageGen=false

      - name: 打包 Release APK
        continue-on-error: true
        run: ./gradlew --no-daemon assembleRelease -Pdia.localImageGen=false

      - name: 整理文件
        run: |
          mkdir -p out
          cp app/build/outputs/apk/debug/app-debug.apk out/LingXi-Dia-4.0-debug.apk || true
          cp app/build/outputs/apk/release/app-release.apk out/LingXi-Dia-4.0-release.apk || true

      - name: 上传 APK
        uses: actions/upload-artifact@v4
        with:
          name: LingXi-Dia-apk
          path: out/*.apk
          if-no-files-found: error
